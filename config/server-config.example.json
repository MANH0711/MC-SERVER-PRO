{
  "server": {
    "instanceName": "MC-SRV-ENT-LINE01",
    "listenPort": 5000,
    "maxConcurrentClients": 128,
    "bufferSizeLimitBytes": 1048576,
    "keepAliveIntervalMs": 5000,
    "watchdogTimeoutMs": 15000,
    "autoReconnect": true,
    "reconnectMaxAttempts": 5,
    "backoffBaseDelayMs": 1000
  },
  "protocol": {
    "defaultBoundary": "AUTO_DETECT",
    "supportedBoundaries": ["20013_STANDARD", "20014_EXTENDED", "VARIABLE_LENGTH"],
    "checksumAlgorithm": "LRC_MOD256",
    "delimiter": {
      "stx": "0x02",
      "etx": "0x03"
    }
  },
  "mes": {
    "endpointUrl": "https://mes-api.internal-factory.net/v1/communication",
    "timeoutMs": 3000,
    "circuitBreakerFailureThreshold": 3,
    "circuitBreakerCooldownMs": 10000,
    "retryMaxCount": 3
  },
  "logging": {
    "level": "INFO",
    "retentionDays": 30,
    "maskSensitivePayloads": true
  }
}
