# ═══════════════════════════════════════════════════════
#  MC SERVER PRO - BACKEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════

# ─── Application ───
APP_NAME=MC-SERVER-BACKEND
APP_PORT=3000
NODE_ENV=development

# ─── gRPC Server ───
GRPC_HOST=0.0.0.0
GRPC_PORT=5050

# ─── TCP Socket Server (Equipment connections) ───
TCP_HOST=0.0.0.0
TCP_PORT=5000
TCP_MAX_CLIENTS=128
TCP_BUFFER_LIMIT_BYTES=1048576
TCP_KEEPALIVE_MS=5000
TCP_WATCHDOG_TIMEOUT_MS=15000

# ─── Oracle Database: ITMDEV (Development) ───
ORACLE_ITMDEV_HOST=112.160.65.212
ORACLE_ITMDEV_PORT=1521
ORACLE_ITMDEV_SERVICE=MIGHTY
ORACLE_ITMDEV_USER=your_dev_user
ORACLE_ITMDEV_PASSWORD=your_dev_password
ORACLE_ITMDEV_POOL_MIN=2
ORACLE_ITMDEV_POOL_MAX=10

# ─── Oracle Database: ITMMES (Production MES) ───
ORACLE_ITMMES_HOST=192.168.80.20
ORACLE_ITMMES_PORT=1521
ORACLE_ITMMES_SERVICE=ITMMES
ORACLE_ITMMES_USER=your_mes_user
ORACLE_ITMMES_PASSWORD=your_mes_password
ORACLE_ITMMES_POOL_MIN=4
ORACLE_ITMMES_POOL_MAX=20

# ─── Oracle Database: ITMVMES (Vietnam MES - Failover) ───
ORACLE_ITMVMES_HOST_PRIMARY=192.168.35.202
ORACLE_ITMVMES_HOST_SECONDARY=192.168.35.203
ORACLE_ITMVMES_PORT=1521
ORACLE_ITMVMES_SERVICE=ITMVMES
ORACLE_ITMVMES_USER=your_vmes_user
ORACLE_ITMVMES_PASSWORD=your_vmes_password
ORACLE_ITMVMES_POOL_MIN=4
ORACLE_ITMVMES_POOL_MAX=20

# ─── Oracle Database: ITMVPACKMES (Packaging MES - Failover) ───
ORACLE_ITMVPACKMES_HOST_PRIMARY=192.168.110.10
ORACLE_ITMVPACKMES_HOST_SECONDARY=192.168.110.10
ORACLE_ITMVPACKMES_PORT=1521
ORACLE_ITMVPACKMES_SERVICE=ITMVPACKMES
ORACLE_ITMVPACKMES_USER=your_pack_user
ORACLE_ITMVPACKMES_PASSWORD=your_pack_password
ORACLE_ITMVPACKMES_POOL_MIN=2
ORACLE_ITMVPACKMES_POOL_MAX=10

# ─── Oracle Database: GWDB (Gateway) ───
ORACLE_GWDB_HOST=192.168.250.53
ORACLE_GWDB_PORT=1521
ORACLE_GWDB_SERVICE=GWDB
ORACLE_GWDB_USER=your_gw_user
ORACLE_GWDB_PASSWORD=your_gw_password
ORACLE_GWDB_POOL_MIN=2
ORACLE_GWDB_POOL_MAX=10

# ─── MES API Integration ───
MES_ENDPOINT_URL=https://mes-api.smartfactory.internal:8443/v2/production
MES_TIMEOUT_MS=3000
MES_CIRCUIT_BREAKER_THRESHOLD=3
MES_CIRCUIT_BREAKER_COOLDOWN_MS=10000
MES_RETRY_MAX=3

# ─── Logging ───
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MASK_SENSITIVE=true
